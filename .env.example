NEXASALON_DATABASE_URL=postgresql+psycopg://nexasalon_app:troque-esta-senha@localhost:5432/nexasalon
# Só usada por `alembic upgrade head` — aponta pro role DONO do schema,
# nunca pro nexasalon_app restrito. Ausente = cai em NEXASALON_DATABASE_URL
# (ok para local/testes; em staging/produção, defina as duas separadas).
NEXASALON_MIGRATIONS_DATABASE_URL=
NEXASALON_ENVIRONMENT=development
NEXASALON_DEV_AUTH_ENABLED=true

# JWT — troque por um segredo forte e único em staging/produção
# (Settings recusa subir nesses ambientes com o valor default).
NEXASALON_JWT_SECRET=troque-por-um-segredo-forte-e-unico-em-producao
NEXASALON_ACCESS_TOKEN_TTL_MINUTES=15
NEXASALON_REFRESH_TOKEN_TTL_DAYS=30
NEXASALON_ORG_SELECTION_TOKEN_TTL_MINUTES=5
NEXASALON_INVITE_TOKEN_TTL_DAYS=7

# Cookie do refresh token — Secure=true é obrigatório em staging/produção
# (Settings recusa subir com false). SameSite=none exige Secure=true e é
# necessário quando o frontend está em domínio totalmente diferente da
# API (ex.: Vercel + Render) — ver README > CORS/CSRF.
NEXASALON_REFRESH_COOKIE_SECURE=true
NEXASALON_REFRESH_COOKIE_SAMESITE=lax
NEXASALON_REFRESH_COOKIE_DOMAIN=

# CORS — allowlist explícita, nunca "*". Separado por vírgula.
NEXASALON_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting — Settings recusa subir em staging/produção com false.
NEXASALON_RATE_LIMIT_ENABLED=true
NEXASALON_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
NEXASALON_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Pool de conexões (SQLAlchemy) — defaults iguais aos que já eram
# usados implicitamente; ajuste se o Postgres gerenciado limitar
# conexões simultâneas.
NEXASALON_DB_POOL_SIZE=5
NEXASALON_DB_MAX_OVERFLOW=10

# Nível de log. NUNCA logamos senha/JWT/cookie/invite_token em nenhum nível.
NEXASALON_LOG_LEVEL=INFO

# Estratégia de IP real do cliente (rate limiting), Etapa 3C. Ver
# docstring em core/config.py e README > "IP real do cliente e rate
# limiting". "trust_first_proxy_hop" (default) é específico da
# topologia atual (Cloudflare + Load Balancer da Render); troque para
# "socket_only" se essa suposição precisar ser revista (mudança de
# provedor, por exemplo) — modo conservador, sem confiar em nenhum
# header, ao custo de rate limiting por IP virar global do serviço.
NEXASALON_CLIENT_IP_STRATEGY=trust_first_proxy_hop
