NEXASALON_DATABASE_URL=postgresql+psycopg://nexasalon_app:troque-esta-senha@localhost:5432/nexasalon
NEXASALON_ENVIRONMENT=development
NEXASALON_DEV_AUTH_ENABLED=true

# JWT — troque por um segredo forte e único em produção (Settings recusa
# subir em produção com o valor default).
NEXASALON_JWT_SECRET=troque-por-um-segredo-forte-e-unico-em-producao
NEXASALON_ACCESS_TOKEN_TTL_MINUTES=15
NEXASALON_REFRESH_TOKEN_TTL_DAYS=30
NEXASALON_ORG_SELECTION_TOKEN_TTL_MINUTES=5
NEXASALON_INVITE_TOKEN_TTL_DAYS=7

# Cookie do refresh token — Secure=true é obrigatório em produção
# (Settings recusa subir com false). SameSite=none exige Secure=true e
# só é necessário se o frontend estiver em domínio totalmente diferente
# da API (ver README > CORS/CSRF).
NEXASALON_REFRESH_COOKIE_SECURE=true
NEXASALON_REFRESH_COOKIE_SAMESITE=lax
NEXASALON_REFRESH_COOKIE_DOMAIN=

# CORS — allowlist explícita, nunca "*". Separado por vírgula.
NEXASALON_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting — Settings recusa subir em produção com false.
NEXASALON_RATE_LIMIT_ENABLED=true
NEXASALON_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
NEXASALON_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
